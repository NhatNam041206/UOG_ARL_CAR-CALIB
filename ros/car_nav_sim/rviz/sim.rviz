Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: map
      Cell Size: 1
      Plane Cell Count: 12
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
      Color Scheme: map
    - Class: rviz_default_plugins/Map
      Name: Global costmap
      Enabled: true
      Topic:
        Value: /global_costmap/costmap
      Color Scheme: costmap
      Alpha: 0.4
    - Class: rviz_default_plugins/Map
      Name: Local costmap
      Enabled: true
      Topic:
        Value: /local_costmap/costmap
      Color Scheme: costmap
      Alpha: 0.5
    - Class: rviz_default_plugins/LaserScan
      Name: Scan (upright)
      Enabled: true
      Topic:
        Value: /scan_nav
        Reliability Policy: Best Effort
      Size (m): 0.04
      Color Transformer: FlatColor
      Color: 255; 0; 0
    - Class: rviz_default_plugins/Path
      Name: Global plan
      Enabled: true
      Topic:
        Value: /plan
      Color: 0; 120; 255
    - Class: rviz_default_plugins/Path
      Name: Local plan
      Enabled: true
      Topic:
        Value: /local_plan
      Color: 0; 200; 0
    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Enabled: true
      Topic:
        Value: /local_costmap/published_footprint
      Color: 255; 200; 0
    - Class: rviz_default_plugins/Polygon
      Name: Stop zone
      Enabled: true
      Topic:
        Value: /polygon_stop
      Color: 255; 0; 0
    - Class: rviz_default_plugins/Odometry
      Name: True pose
      Enabled: true
      Topic:
        Value: /sim/ground_truth
      Keep: 1
      Shape:
        Value: Arrow
        Color: 255; 0; 255
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: AMCL pose
      Enabled: true
      Topic:
        Value: /amcl_pose
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: nav2_rviz_plugins/GoalTool
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 80
      X: 4.5
      Y: 3
Window Geometry:
  Width: 1400
  Height: 900
