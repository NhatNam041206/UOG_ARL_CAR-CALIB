<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypelevel="1.0"?>
<package format="3">
  <name>car_nav</name>
  <version>0.1.0</version>
  <description>NAV2 mode for the car-calib skid-steer car: sensor bring-up (RPLIDAR A1 + Astra Pro), self-mask, wall-approach speed logger.</description>
  <maintainer email="noreply@example.com">car-calib</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <!-- nav.launch.py also needs Nav2, slam_toolbox and rf2o. They are NOT
       listed here on purpose: the ros-nav (car) image stays sensors-only
       until WO-03. docker/sim/Dockerfile installs them. -->
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_xml</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>sllidar_ros2</exec_depend>
  <exec_depend>astra_camera</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
